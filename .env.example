# Neon Database URL (Pooled connection is recommended for serverless)
DATABASE_URL="postgresql://user:password@host-pooler.us-east-1.aws.neon.tech/neondb?sslmode=require"

# Security
# CRON_SECRET: ใช้สำหรับเรียก API Automated Notify ผ่าน Cron Job
CRON_SECRET="your-random-secret-key"

# Optional: Line Notify Default Token (Usually managed via System Settings UI)
# LINE_NOTIFY_TOKEN="your-line-notify-token"
